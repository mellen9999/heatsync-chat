# Maintainer: mellen
# builds from this checkout's committed history (git archive HEAD), so a dirty tree never ships:
#   cd packaging/arch && paru -Bi .        (or: makepkg -si)
# it lives in its own folder on purpose: makepkg's src/ and pkg/ work dirs would land on the repo's own src/
# the version is worked out here, when makepkg reads this file, and never written back into it: a pkgver()
# function makes makepkg rewrite `pkgver=` in place, which kept dirtying the checkout with a stale number
pkgname=heatsync-chat
_top=$(git -C "${startdir:-$PWD}" rev-parse --show-toplevel)
# <version in Cargo.toml>.r<commits>.g<hash>: every landed commit is a newer package, so paru -Bi . always upgrades
_ver=$(git -C "$_top" show HEAD:Cargo.toml | sed -n 's/^version = "\(.*\)"/\1/p' | head -1)
pkgver=$_ver.r$(git -C "$_top" rev-list --count HEAD).g$(git -C "$_top" rev-parse --short=7 HEAD)
pkgrel=1
pkgdesc='twitch, kick and youtube chat in one native window, with heatsync emotes'
arch=(x86_64 aarch64)
url='https://heatsync.org'
license=(MIT)
depends=(glibc gcc-libs fontconfig freetype2 libxkbcommon wayland)
makedepends=(cargo git)
optdepends=(
  'libnotify: desktop notification on an @mention'
  'xdg-utils: open the login page and links'
  'zenity: file dialog for uploads'
  'wl-clipboard: copy and paste on wayland'
  'xclip: copy and paste on x11'
  'libx11: x11 sessions'
  'mpv: video links play in their own window'
  'yt-dlp: lets mpv play youtube and clip links'
  'pipewire: the mention sound (paplay or aplay work too)'
)
# ring compiles C: arch's lto flags break its link
options=(!lto !debug)
conflicts=(heatsync-chat-bin)

prepare() {
  rm -rf "$srcdir/$pkgname"
  mkdir -p "$srcdir/$pkgname"
  git -C "$_top" archive HEAD | tar -x -C "$srcdir/$pkgname"
  cd "$srcdir/$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/$pkgname"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$srcdir/$pkgname"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "$srcdir/$pkgname"
  install -Dm755 target/release/heatsync-chat "$pkgdir/usr/bin/heatsync-chat"
  install -Dm644 packaging/heatsync-chat.desktop "$pkgdir/usr/share/applications/heatsync-chat.desktop"
  install -Dm644 assets/icon-48.png "$pkgdir/usr/share/icons/hicolor/48x48/apps/heatsync-chat.png"
  install -Dm644 assets/icon-96.png "$pkgdir/usr/share/icons/hicolor/96x96/apps/heatsync-chat.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
