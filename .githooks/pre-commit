#!/usr/bin/env bash
set -e

GITLEAKS="$(command -v gitleaks 2>/dev/null || echo "$HOME/.local/bin/gitleaks")"
if [ -x "$GITLEAKS" ]; then
  "$GITLEAKS" git --staged --redact --no-banner || { echo "gitleaks: staged secret, commit blocked" >&2; exit 1; }
else
  # a missing scanner is not a clean scan — this is a public repo
  echo "gitleaks missing — commit blocked. install: paru -S gitleaks (HS_GITLEAKS_SKIP_OK=1 waives it for one commit)" >&2
  [ "${HS_GITLEAKS_SKIP_OK:-}" = 1 ] || exit 1
fi

PII="$HOME/sync/config/githooks/pii-scan"
[ -x "$PII" ] && { "$PII" || exit 1; }

cargo fmt --check
cargo clippy --release -q --all-targets -- -D warnings
cargo test --release -q
